{
  "rewrites": [
    { "source": "/feed",              "destination": "/feed/index.html" },
    { "source": "/feed/",             "destination": "/feed/index.html" },
    { "source": "/brands/",           "destination": "/brands/index.html" },
    { "source": "/brands/:slug",      "destination": "/brands/brand.html" },
    { "source": "/brands/:slug/",     "destination": "/brands/brand.html" },
    { "source": "/rankings",          "destination": "/rankings/index.html" },
    { "source": "/rankings/",         "destination": "/rankings/index.html" },
    { "source": "/matchups",          "destination": "/matchups/index.html" },
    { "source": "/matchups/",         "destination": "/matchups/index.html" },
    { "source": "/matchups/:date",    "destination": "/matchups/day.html" },
    { "source": "/matchups/:date/",   "destination": "/matchups/day.html" },
    { "source": "/scorecard",         "destination": "/scorecard/index.html" },
    { "source": "/scorecard/",        "destination": "/scorecard/index.html" },
    { "source": "/scorecard/:slug",   "destination": "/scorecard/article.html" },
    { "source": "/scorecard/:slug/",  "destination": "/scorecard/article.html" },
    { "source": "/news/:slug",        "destination": "/news/:slug/index.html" },
    { "source": "/news/:slug/",       "destination": "/news/:slug/index.html" }
  ],
  "functions": {
    "api/feed.js":              { "maxDuration": 15 },
    "api/subscribe.js":         { "maxDuration": 10 },
    "api/take.js":              { "maxDuration": 30 },
    "api/click.js":             { "maxDuration": 10 },
    "api/matchup-result.js":    { "maxDuration": 30 },
    "api/dormied-articles.js":  { "maxDuration": 10 },
    "api/originals-feed.js":    { "maxDuration": 10 },
    "api/post-to-x.js":         { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/js/data.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }]
    },
    {
      "source": "/js/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/css/(.*)\\.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
