# Copy this to .env and fill in your credentials.
# Never commit .env to version control.

# Anthropic API key — used by scripts/generate-explanations.js
ANTHROPIC_API_KEY=

# Supabase project URL — e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase service role key — backend only (never expose on frontend)
SUPABASE_SERVICE_KEY=

# Supabase anon (public) key — goes in js/explanations.js (safe to expose)
SUPABASE_ANON_KEY=

# Beehiiv newsletter — used by api/subscribe.js (server-side only)
BEEHIIV_PUBLICATION_ID=
BEEHIIV_API_KEY=
