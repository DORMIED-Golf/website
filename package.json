{
  "name": "dormied-website",
  "version": "1.0.0",
  "private": true,
  "description": "DORMIED \u2014 Golf's brand desk. 215 brands. 10 markets. Ranked monthly.",
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "generate-brands": "node scripts/generate-brand-page.js",
    "generate-brands:force": "node scripts/generate-brand-page.js --force",
    "verify:brands": "node scripts/verify-brands.js",
    "generate-index-pages": "node scripts/generate-index-pages.js",
    "generate-index-pages:brands": "node scripts/generate-index-pages.js --brands",
    "generate-index-pages:news": "node scripts/generate-index-pages.js --news",
    "generate-index-pages:scorecard": "node scripts/generate-index-pages.js --scorecard",
    "verify:index-pages": "node scripts/verify-index-pages.js",
    "generate-scorecard": "node scripts/generate-scorecard-page.js",
    "generate-scorecard:force": "node scripts/generate-scorecard-page.js --force",
    "verify:scorecard": "node scripts/verify-scorecard-pages.js",
    "regenerate:sitemap": "node scripts/generate-sitemap.js",
    "verify:sitemap": "node scripts/verify-sitemap.js",
    "regenerate:search-index": "node scripts/generate-search-index.js",
    "deploy": "vercel --prod",
    "verify:css": "node scripts/verify-css-parity.js",
    "verify:page-scripts": "node scripts/verify-page-scripts.js",
    "fix:assets": "node scripts/fix-asset-versions.js",
    "verify:assets": "node scripts/fix-asset-versions.js --check",
    "generate-llms": "node scripts/generate-llms-txt.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^17.3.1",
    "rss-parser": "^3.13.0",
    "twitter-api-v2": "^1.29.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "sharp": "^0.34.5",
    "terser": "^5.46.2"
  }
}
